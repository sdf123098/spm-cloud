# Copy to .env, replace the domain and bootstrap token, then run docker compose up -d --build.
SPM_CLOUD_HOST=cloud.example.com
SPM_CLOUD_ORIGIN=https://cloud.example.com
SPM_CLOUD_INSTANCE_ID=self-hosted
SPM_CLOUD_ACCESS_TOKEN=replace-with-a-long-random-bootstrap-token
SPM_CLOUD_BOOTSTRAP_ACCOUNT=account_local
# Open player registration matches official Cloud. Explicit false restricts registration to the operator.
SPM_CLOUD_ALLOW_SELF_REGISTRATION=true
# Optional: set a real Argon2id hash to enable password login for the bootstrap account.
# SPM_CLOUD_BOOTSTRAP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
