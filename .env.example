# Legacy ENV-only backend configuration for existing deployments.
# New installations should use docker-compose.json.yml and config.json.
# 仅供已有部署继续使用的旧 ENV 后端配置；新安装请用 JSON。
# Native deployments use .env.native.example / 原生部署使用 .env.native.example。

# Public address and stable instance ID / 公网地址与固定实例 ID
SPM_CLOUD_HOST=cloud.example.com
SPM_CLOUD_ORIGIN=https://cloud.example.com
SPM_CLOUD_INSTANCE_ID=self-hosted

# Keep this operator secret private and stable across upgrades.
# 管理密钥由服主保管，升级时保留，不是玩家密码。
SPM_CLOUD_ACCESS_TOKEN=replace-with-a-long-random-bootstrap-token
SPM_CLOUD_BOOTSTRAP_ACCOUNT=account_local
SPM_CLOUD_ALLOW_SELF_REGISTRATION=true
# Optional Argon2id hash, not a plain password / 可选 Argon2id 摘要，不是明文密码
# SPM_CLOUD_BOOTSTRAP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'

# Optional external login; use ONE of these options / 可选外置登录，以下两种选一种
# A full hasJoined URL, including all-in-one / 完整 hasJoined 地址，支持 all-in-one
# SPM_CLOUD_HAS_JOINED_URL=https://auth.example.com/all-in-one/hasJoined
# Several providers or an existing provider ID / 多服务或沿用已有提供方 ID
# SPM_CLOUD_IDENTITY_PROVIDERS='[{"provider_id":"my-auth","display_name":"My Auth","has_joined_url":"https://auth.example.com/hasJoined","enabled":true}]'

# Limits in bytes: 128 MiB per asset, 64 KiB per message.
# 字节数限制：单模型 128 MiB，单协议消息 64 KiB。
SPM_CLOUD_MAX_ASSET_BYTES=134217728
SPM_CLOUD_MAX_MESSAGE_BYTES=65536

# Keep existing volume names when upgrading / 升级时保留现有卷名
SPM_CLOUD_DATA_VOLUME=spm-cloud-data
SPM_CLOUD_OBJECTS_VOLUME=spm-cloud-objects
# Change both together if this subnet conflicts with an existing network.
# 如与已有网络冲突，同时修改子网和代理 IP；代理 IP 必须在子网内。
SPM_CLOUD_NETWORK_SUBNET=172.30.10.0/24
SPM_CLOUD_PROXY_IP=172.30.10.3
