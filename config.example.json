{
  "schema_version": 1,
  "instance": {
    "instance_id": "self-hosted",
    "origin": "https://cloud.example.com",
    "bind": "127.0.0.1:8787",
    "trusted_proxy_ips": [
      "127.0.0.1"
    ]
  },
  "storage": {
    "data_dir": "data",
    "database_path": "data/spm-cloud.db",
    "object_dir": "data/objects",
    "backend": "sqlite",
    "mysql_url_file": null
  },
  "auth": {
    "allow_self_registration": true,
    "bootstrap_account_id": "account_local",
    "bootstrap_access_token_file": "secrets/bootstrap-token.txt",
    "bootstrap_password_hash_file": null,
    "identity_providers": []
  },
  "limits": {
    "max_asset_bytes": 134217728,
    "max_message_bytes": 65536,
    "max_entity_query_count": 64,
    "max_visual_state_bytes": 8192,
    "max_visual_variables": 32,
    "max_projectile_snapshots_per_publisher": 256,
    "max_projectile_snapshots_per_world": 4096,
    "visual_publish_requests_per_second": 20,
    "visual_publish_burst": 40
  },
  "features": {
    "entity_motion": false,
    "player_display_state": false,
    "vehicle_bindings": false,
    "projectile_snapshots": false
  },
  "retention": {
    "projectile_idle_ttl_seconds": 600,
    "projectile_max_lifetime_seconds": 86400,
    "cleanup_interval_seconds": 60
  },
  "logging": {
    "level": "info",
    "format": "text"
  },
  "web_ui": {
    "enabled": true,
    "microsoft_client_id": null,
    "microsoft_client_secret_file": null,
    "microsoft_redirect_uri": null
  },
  "moderation": {
    "detection_enabled": false,
    "block_r18": false,
    "block_unclassified": false,
    "texture_detection_enabled": false,
    "scanner_url": null,
    "score_threshold": 0.7,
    "timeout_seconds": 30,
    "max_textures": 64,
    "max_texture_bytes": 8388608,
    "ysm_parser_path": null
  },
  "performance": {
    "preset": "medium",
    "upload_concurrency": 4,
    "model_processing_concurrency": 2
  },
  "updates": {
    "auto_update": false,
    "check_interval_hours": 24
  },
  "cache": {
    "backend": "memory",
    "redis_url_file": null,
    "ttl_seconds": 30,
    "max_pages": 256,
    "timeout_ms": 300
  },
  "offline_identity": {
    "authorization_mode": "automatic",
    "max_identities_per_account": 3,
    "session_ttl_seconds": 60,
    "activation_requests_per_minute": 10,
    "issuance_requests_per_hour": 5
  }
}
