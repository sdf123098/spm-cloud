{
  "name": "spm-cloud-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --resolveJsonModule --skipLibCheck --types ./worker-configuration.d.ts src/index.ts src/scope-room.ts",
    "test:recovery": "node tests/recovery-smoke.mjs",
    "test:recovery-integration": "node tests/recovery-integration.mjs",
    "test:upload-metadata": "node tests/upload-metadata-integration.mjs",
    "test:identity-panel": "node tests/identity-panel-integration.mjs",
    "test:player-motion": "node tests/player-motion-integration.mjs",
    "test:projectile-snapshot": "node tests/projectile-snapshot-integration.mjs",
    "test:player-display": "node tests/player-display-integration.mjs",
    "test:vehicle-appearance": "node tests/vehicle-appearance-integration.mjs",
    "test:entity-motion": "node tests/entity-motion-integration.mjs",
    "test:game-auth": "node tests/game-auth-smoke.mjs",
    "test:game-auth-integration": "node tests/game-auth-integration.mjs",
    "test:login-parity": "node tests/login-parity-integration.mjs",
    "test:provider-egress": "node tests/provider-egress-smoke.mjs",
    "test:official-key-egress": "node tests/official-key-egress-smoke.mjs",
    "refresh:mojang-keys": "node tools/refresh-mojang-keys.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply spm-cloud --local",
    "d1:migrate:remote": "wrangler d1 migrations apply spm-cloud --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "miniflare": "5.20260925.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "4.136.2"
  }
}
