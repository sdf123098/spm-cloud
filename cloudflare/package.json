{
  "name": "spm-cloud-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --types ./worker-configuration.d.ts src/index.ts src/scope-room.ts",
    "d1:migrate:local": "wrangler d1 migrations apply spm-cloud --local",
    "d1:migrate:remote": "wrangler d1 migrations apply spm-cloud --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^7.0.2",
    "wrangler": "4.136.2"
  }
}
