# Legacy native ENV-only backend configuration for existing deployments.
# New installations should initialize config.json with --init-config.
# 仅供已有部署继续使用的原生后端 ENV 配置；新安装请用 --init-config 生成 JSON。
# Rust does not load this file automatically / Rust 不会自动读取此文件。

SPM_CLOUD_INSTANCE_ID=self-hosted
SPM_CLOUD_ORIGIN=https://cloud.example.com
SPM_CLOUD_BIND=127.0.0.1:8787
# Relative to the process working directory / 相对于程序工作目录
SPM_CLOUD_DATA_DIR=data
SPM_CLOUD_DATABASE=data/spm-cloud.db
SPM_CLOUD_OBJECT_DIR=objects

# Replace with a persistent random operator secret / 替换为固定保存的随机管理密钥
SPM_CLOUD_ACCESS_TOKEN=replace-with-a-long-random-bootstrap-token
SPM_CLOUD_BOOTSTRAP_ACCOUNT=account_local
SPM_CLOUD_ALLOW_SELF_REGISTRATION=true
SPM_CLOUD_TRUSTED_PROXY_IPS=127.0.0.1
SPM_CLOUD_MAX_ASSET_BYTES=134217728
SPM_CLOUD_MAX_MESSAGE_BYTES=65536

# Optional external login; use ONE of the following / 可选外置登录，以下两种选一种
# A full hasJoined URL, including all-in-one / 完整 hasJoined 地址，支持 all-in-one
# SPM_CLOUD_HAS_JOINED_URL=https://auth.example.com/all-in-one/hasJoined
# Several providers or an existing provider ID / 多服务或沿用已有提供方 ID
# SPM_CLOUD_IDENTITY_PROVIDERS='[{"provider_id":"my-auth","display_name":"My Auth","has_joined_url":"https://auth.example.com/hasJoined","enabled":true}]'

# Optional Argon2id hash, not a plain password / 可选 Argon2id 摘要，不是明文密码
# SPM_CLOUD_BOOTSTRAP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
