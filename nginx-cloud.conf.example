# Include this snippet inside the HTTPS server block for the SPM Cloud hostname.
# It keeps the reverse-proxy request limit aligned with the backend default (128 MiB).
client_max_body_size 128m;

location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-SPM-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
